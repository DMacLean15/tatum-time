# Cloudflare Pages headers - caching + basic security.
# The vendored marked.min.js and uploaded photos rarely change; give
# browsers permission to keep them so repeat visits skip re-downloads.

# page scripts are loaded as /js/<file>.js?v=<content hash> (stamped by build-pages.js),
# so a new version always has a new URL and browsers can keep each one for a year
/js/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=604800

# WebP copies are generated from the upload; a changed photo gets a new upload name
/images/uploads/_v/*
  Cache-Control: public, max-age=31536000, immutable

/_v/*
  Cache-Control: public, max-age=604800

# self-hosted fonts never change in place (a new version gets a new name)
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/og/*
  Cache-Control: public, max-age=86400

/mp3/*
  Cache-Control: public, max-age=604800

/og.jpg
  Cache-Control: public, max-age=86400

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: SAMEORIGIN
# (SAMEORIGIN also covers /admin - Cloudflare merges duplicate header rules, so no second value)

/favicon.ico
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/icon-192.png
  Cache-Control: public, max-age=604800

/icon-512.png
  Cache-Control: public, max-age=604800
